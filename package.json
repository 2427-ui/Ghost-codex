{
  "name": "ghost-studio",
  "version": "0.3.1",
  "license": "MIT",
  "description": "Ghost Studio · 本地 Codex 研究工作台",
  "author": "Ghost Studio contributors",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "playwright test",
    "check:codex": "tsx scripts/check-codex.ts",
    "package": "npm run build && npm run licenses && electron-builder --win nsis && npm run dist:checksums",
    "package:dir": "npm run build && npm run licenses && electron-builder --dir && npm run dist:checksums",
    "check": "npm run typecheck && npm test && npm run check:repo",
    "check:repo": "node scripts/check-repository.mjs && tsx scripts/write-interface-coverage.ts --check",
    "check:ui": "node scripts/check-ui.cjs",
    "check:ui:native": "node scripts/check-native-ui.cjs",
    "check:ui:packaged": "node scripts/check-native-ui.cjs --packaged",
    "check:icons": "node scripts/check-icons.cjs",
    "check:package": "node scripts/check-package.mjs",
    "check:capabilities": "tsx scripts/check-capabilities.ts",
    "check:history": "tsx scripts/check-shared-history.ts",
    "check:service:live": "tsx scripts/check-service.ts --live",
    "check:review:live": "tsx scripts/check-review.ts --live",
    "check:operations:live": "tsx scripts/check-live-operations.ts --live",
    "icons": "node scripts/create-icon.mjs",
    "licenses": "node scripts/licenses.mjs",
    "docs:interfaces": "tsx scripts/write-interface-coverage.ts",
    "protocol:generate": "node scripts/generate-capabilities.mjs",
    "dist:checksums": "node scripts/write-checksums.mjs",
    "check:workflows": "playwright test workflows.spec.ts",
    "check:publication": "node scripts/check-publication.mjs",
    "audit:dependencies": "npm audit"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "3.4.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
